# App
# Use the production origin in Vercel, e.g. https://example.com.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public support/contact email shown in legal pages and settings.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
# Required by @ai-sdk/google.
GOOGLE_GENERATIVE_AI_API_KEY=
# Required by /api/transcribe.
OPENAI_API_KEY=

# Stripe subscriptions
# Required when /api/stripe/checkout, /api/stripe/portal, or /api/stripe/webhook are enabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Preferred current price IDs for the Unlimited plan.
STRIPE_PRICE_UNLIMITED_MONTHLY=
STRIPE_PRICE_UNLIMITED_YEARLY=

# Legacy fallback names. Fill these only if you have not set STRIPE_PRICE_UNLIMITED_*.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Stripe credit grants
# Optional. Defaults are 3000 monthly allowance and 500 upgrade proration credits.
BILLING_UNLIMITED_MONTHLY_ALLOWANCE_CREDITS=3000
BILLING_UNLIMITED_UPGRADE_PRORATION_CREDITS=500

# Optional Stripe Payment Link for one-time top-up UI.
# Leave empty to keep the top-up button disabled.
NEXT_PUBLIC_STRIPE_CHECKOUT_TOPUP_20=

# Monitoring
# Set to 1 in production when Stripe billing must be considered healthy.
STRIPE_HEALTHCHECK_REQUIRED=0
# Optional. If set, /api/health requires this token via query or x-healthcheck-token.
HEALTHCHECK_TOKEN=
